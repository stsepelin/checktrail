      "sourceUtf8": "#!/bin/sh\nset -eu\n/usr/lib/apt/apt-helper --version > /output/apt-version.txt\npython3 /controller/store.py\ncp /usr/share/keyrings/debian-archive-keyring.gpg /output/debian-archive-keyring.gpg\n"
