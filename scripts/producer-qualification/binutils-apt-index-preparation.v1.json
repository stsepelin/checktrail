      "file": "store.py",
      "bytes": 1423,
      "sha256": "94aa66dc1d97bc1a568b0f577ae8f6742ceb97908a251d942ef907301ab17a76",
      "sourceUtf8": "import json,hashlib,subprocess,os\nfrom pathlib import Path\nrows=json.loads(Path('/controller/expected.json').read_text())\nfor i,row in enumerate(rows):\n uri=f'store:/inputs/index-{i}.xz';filename=f'/output/index-{i}.lz4'\n packet=f'600 URI Acquire\\nURI: {uri}\\nFilename: {filename}\\nExpected-SHA256: {row[\"sha256\"]}\\nExpected-Checksum-FileSize: {row[\"bytes\"]}\\n\\n'.encode()\n p=subprocess.run(['/usr/lib/apt/methods/store'],input=packet,capture_output=True,timeout=30)\n Path(f'/output/store-{i}.stdout').write_bytes(p.stdout);Path(f'/output/store-{i}.stderr').write_bytes(p.stderr)\n assert p.returncode==0,(p.returncode,p.stderr.decode(errors='replace'))\n responses=[part for part in p.stdout.split(b'\\n\\n') if part.startswith(b'201 URI Done\\n')]\n assert len(responses)==1,(i,p.stdout.decode(errors='replace'))\n fields=dict(line.split(b': ',1) for line in responses[0].splitlines()[1:] if b': ' in line)\n assert fields[b'URI']==uri.encode() and fields[b'Filename']==filename.encode()\nfiles=['/usr/lib/apt/apt-helper','/usr/lib/apt/methods/store','/usr/lib/x86_64-linux-gnu/libapt-pkg.so.6.0','/usr/share/keyrings/debian-archive-keyring.gpg']\nidentities=[]\nfor name in files:\n p=Path(os.path.realpath(name));raw=p.read_bytes();identities.append({'file':name,'physicalFile':str(p),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest()})\nPath('/output/tool-identities.json').write_text(json.dumps(identities,indent=2)+'\\n')\n"
    },
