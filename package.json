{
  "name": "@stsepelin/checktrail",
  "version": "0.1.0-alpha.5",
  "mcpName": "io.github.stsepelin/checktrail",
  "description": "Local code validation with execution evidence, a CLI, and MCP tools.",
  "type": "module",
  "license": "MIT",
  "author": "stsepelin",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "checktrail": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "assets/context-grammars",
    "assets/context-vb-grammar",
    "schemas",
    "packs",
    "server.json",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stsepelin/checktrail.git"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts examples/javascript examples/contracts examples/package-contract examples/mutations examples/vue-router examples/nuxt examples/review eslint.config.js",
    "format:check": "prettier --check .",
    "test": "npm run build && node scripts/run-test-suite.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "probe:mcp-tasks": "node scripts/probe-mcp-tasks.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fast-xml-parser": "5.12.0",
    "smol-toml": "1.9.1",
    "typescript": "6.0.3",
    "web-tree-sitter": "0.27.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "eslint": "10.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "rolldown": "1.2.9",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.0",
    "vitest": "5.1.0",
    "vitest-native-mutation": "npm:vitest@5.0.5",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org"
  }
}
