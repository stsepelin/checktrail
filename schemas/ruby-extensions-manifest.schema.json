{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sources": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
    },
    "manifests": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["file", "sha256"],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "minItems": 1,
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_]+(?:-[A-Za-z0-9_]+)*$"
          },
          "requirement": { "type": "string", "maxLength": 256 },
          "groups": {
            "minItems": 1,
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            }
          },
          "platforms": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            }
          },
          "included": { "type": "boolean" },
          "platformMatches": { "type": "boolean" },
          "source": {
            "anyOf": [
              { "type": "string", "maxLength": 8192 },
              { "type": "null" }
            ]
          }
        },
        "required": [
          "name",
          "requirement",
          "groups",
          "platforms",
          "included",
          "platformMatches",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["sources", "manifests", "dependencies"],
  "additionalProperties": false
}
