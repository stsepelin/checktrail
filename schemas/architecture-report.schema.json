{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "engineVersion": { "type": "string" },
    "provenance": { "type": "string", "const": "imported-dependency-graph" },
    "outcome": { "type": "string", "enum": ["passed", "failed", "incomplete"] },
    "reason": { "type": "string" },
    "artifactFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policyFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "captureComplete": { "type": "boolean" },
    "counts": {
      "type": "object",
      "properties": {
        "projects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "verifiedProjects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unverifiedProjects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dependencies": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "allowed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "forbidden": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unverified": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cycles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "projects",
        "verifiedProjects",
        "unverifiedProjects",
        "dependencies",
        "allowed",
        "forbidden",
        "unverified",
        "cycles"
      ],
      "additionalProperties": false
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "status": {
            "type": "string",
            "enum": ["verified", "missing", "unconfigured", "incomplete"]
          }
        },
        "required": ["id", "status"],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "consumer": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "producer": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "status": {
            "type": "string",
            "enum": ["allowed", "forbidden", "unverified"]
          }
        },
        "required": ["consumer", "producer", "status"],
        "additionalProperties": false
      }
    },
    "cycles": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    }
  },
  "required": [
    "schemaVersion",
    "engineVersion",
    "provenance",
    "outcome",
    "reason",
    "artifactFingerprint",
    "policyFingerprint",
    "captureComplete",
    "counts",
    "projects",
    "dependencies",
    "cycles"
  ],
  "additionalProperties": false
}
