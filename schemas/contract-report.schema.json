{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "engineVersion": { "type": "string" },
    "provenance": { "type": "string", "const": "imported-contract-samples" },
    "outcome": { "type": "string", "enum": ["passed", "failed", "incomplete"] },
    "reason": { "type": "string" },
    "artifactFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "counts": {
      "type": "object",
      "properties": {
        "contracts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unverified": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "samples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "accepted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rejected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "contracts",
        "passed",
        "failed",
        "unverified",
        "samples",
        "accepted",
        "rejected"
      ],
      "additionalProperties": false
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "outcome": {
            "type": "string",
            "enum": ["passed", "failed", "incomplete"]
          },
          "reason": { "type": "string" },
          "samples": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 1024 },
                "accepted": { "type": "boolean" },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "keyword": { "type": "string" },
                      "instancePath": { "type": "string" },
                      "schemaPath": { "type": "string" }
                    },
                    "required": ["keyword", "instancePath", "schemaPath"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["name", "accepted", "errors"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "outcome", "reason", "samples"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "engineVersion",
    "provenance",
    "outcome",
    "reason",
    "artifactFingerprint",
    "counts",
    "contracts"
  ],
  "additionalProperties": false
}
