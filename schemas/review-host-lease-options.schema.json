{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "allowSourceDisclosure": { "type": "boolean" },
    "maxReads": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "maxPacketBytes": {
      "default": 1048576,
      "type": "integer",
      "minimum": 0,
      "maximum": 8388608
    },
    "maxResponseBytes": {
      "default": 131072,
      "type": "integer",
      "minimum": 0,
      "maximum": 262144
    },
    "wallMs": {
      "default": 30000,
      "type": "integer",
      "minimum": 1,
      "maximum": 120000
    }
  },
  "required": [
    "allowSourceDisclosure",
    "maxReads",
    "maxPacketBytes",
    "maxResponseBytes",
    "wallMs"
  ],
  "additionalProperties": false
}
