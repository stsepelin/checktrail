{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile": { "type": "string", "const": "windows-job-v1" },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "phase": {
      "type": "string",
      "enum": ["assigned", "running", "completed", "failed"]
    },
    "supervisorPid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "childPid": {
      "anyOf": [
        { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        { "type": "null" }
      ]
    },
    "jobAssigned": { "type": "boolean" },
    "resumed": { "type": "boolean" },
    "childExitCode": {
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        { "type": "null" }
      ]
    },
    "activeBeforeCleanup": {
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        { "type": "null" }
      ]
    },
    "activeAfterCleanup": {
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        { "type": "null" }
      ]
    },
    "cleanup": {
      "type": "string",
      "enum": ["confirmed", "unavailable", "not-started"]
    },
    "nativeError": {
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        { "type": "null" }
      ]
    },
    "resources": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "profile": {
                  "type": "string",
                  "const": "windows-job-resources-v1"
                },
                "state": { "type": "string", "const": "collected" },
                "cpuUnit": { "type": "string", "const": "100ns" },
                "processCpu": {
                  "type": "object",
                  "properties": {
                    "user100ns": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "kernel100ns": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["user100ns", "kernel100ns"],
                  "additionalProperties": false
                },
                "jobCpu": {
                  "type": "object",
                  "properties": {
                    "user100ns": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "kernel100ns": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["user100ns", "kernel100ns"],
                  "additionalProperties": false
                },
                "totalJobProcesses": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                },
                "peakWorkingSetBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "memoryScope": {
                  "type": "string",
                  "const": "direct-target-lifetime-peak"
                },
                "collectedAfterJobEmpty": { "type": "boolean", "const": true },
                "summedProcessTreeRss": { "type": "boolean", "const": false }
              },
              "required": [
                "profile",
                "state",
                "cpuUnit",
                "processCpu",
                "jobCpu",
                "totalJobProcesses",
                "peakWorkingSetBytes",
                "memoryScope",
                "collectedAfterJobEmpty",
                "summedProcessTreeRss"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "profile": {
                  "type": "string",
                  "const": "windows-job-resources-v1"
                },
                "state": { "type": "string", "const": "unavailable" },
                "stage": {
                  "type": "string",
                  "enum": [
                    "process-times",
                    "process-memory",
                    "job-accounting",
                    "counter-bounds"
                  ]
                },
                "nativeError": {
                  "anyOf": [
                    { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                    { "type": "null" }
                  ]
                }
              },
              "required": ["profile", "state", "stage", "nativeError"],
              "additionalProperties": false
            }
          ]
        },
        { "type": "null" }
      ]
    },
    "launcherPid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "launcherSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "supervisorSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ownership": { "type": "string", "const": "creation-job-list" },
    "executionSandboxed": { "type": "boolean", "const": false }
  },
  "required": [
    "profile",
    "requestId",
    "phase",
    "supervisorPid",
    "childPid",
    "jobAssigned",
    "resumed",
    "childExitCode",
    "activeBeforeCleanup",
    "activeAfterCleanup",
    "cleanup",
    "nativeError",
    "launcherPid",
    "launcherSha256",
    "supervisorSha256",
    "ownership",
    "executionSandboxed"
  ],
  "additionalProperties": false
}
