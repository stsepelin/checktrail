{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "instructions": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "host": {
      "type": "object",
      "properties": {
        "client": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "clientVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        }
      },
      "required": ["client", "clientVersion", "provider", "model"],
      "additionalProperties": false
    }
  },
  "required": ["instructions", "host"],
  "additionalProperties": false
}
