{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "terraformVersion": { "type": "string", "const": "1.16.5" },
    "platform": { "type": "string", "const": "linux_arm64" },
    "files": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*\\.tf\\.json$"
      }
    }
  },
  "required": ["schemaVersion", "terraformVersion", "platform", "files"],
  "additionalProperties": false
}
