{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "const": "bounded-physical-process-output-v1"
    },
    "stdout": {
      "type": "object",
      "properties": {
        "base64": {
          "type": "string",
          "maxLength": 22369624,
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": ["base64", "bytes", "sha256"],
      "additionalProperties": false
    },
    "stderr": {
      "type": "object",
      "properties": {
        "base64": {
          "type": "string",
          "maxLength": 22369624,
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": ["base64", "bytes", "sha256"],
      "additionalProperties": false
    },
    "observedBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "completeForObservedStreams": { "type": "boolean" }
  },
  "required": [
    "profile",
    "stdout",
    "stderr",
    "observedBytes",
    "completeForObservedStreams"
  ],
  "additionalProperties": false
}
