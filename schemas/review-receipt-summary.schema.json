          },
          "required": [
            "provenance",
            "verified",
            "thisChange",
            "followUp",
            "unknown"
          ],
          "additionalProperties": false
        },
        "reviewerKind": { "type": "string", "enum": ["human", "model"] },
        "observations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        }
      },
      "required": [
        "schemaVersion",
        "engineVersion",
        "channel",
        "automatedCoverage",
        "claimsVerified",
        "deterministicOutcomeChanged",
        "provenance",
        "contextDigest",
        "freshness",
        "usageProvenance",
        "usage",
        "coverage",
        "citations",
        "attribution",
        "fixScope",
        "reviewerKind",
        "observations"
      ],
      "additionalProperties": false
    }
  ]
}
