              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "preExisting": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "unknown": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            }
          },
          "required": [
            "provenance",
            "verified",
            "regression",
            "preExisting",
            "unknown"
          ],
          "additionalProperties": false
        },
        "fixScope": {
