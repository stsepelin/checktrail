{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "runnerLabels": {
      "maxItems": 128,
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" }
    },
    "variables": {
      "maxItems": 256,
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$" }
    }
  },
  "required": ["schemaVersion", "runnerLabels", "variables"],
  "additionalProperties": false
}
