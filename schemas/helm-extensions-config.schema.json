{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "profile": { "type": "string", "const": "local-application-subcharts-v1" },
    "helmVersion": { "type": "string", "const": "4.3.0" },
    "kubernetesVersion": { "type": "string", "const": "1.36.0" },
    "platform": { "type": "string", "const": "linux_arm64" },
    "release": { "type": "string", "const": "original" },
    "namespace": { "type": "string", "const": "original" },
    "charts": {
      "minItems": 3,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
          "directory": {
            "anyOf": [
              { "type": "string", "const": "." },
              {
                "type": "string",
                "maxLength": 256,
                "pattern": "^(?:charts\\/[a-z][a-z0-9-]{0,62})(?:\\/charts\\/[a-z][a-z0-9-]{0,62})*$"
              }
            ]
          },
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
          "properties": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "const": "integer" },
                    "minimum": {
                      "type": "integer",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "maximum": {
                      "type": "integer",
                      "minimum": -1000000,
                      "maximum": 1000000
                    }
                  },
                  "required": ["type"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "const": "string" },
                    "minLength": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2048
                    },
                    "maxLength": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2048
                    },
                    "enum": {
                      "minItems": 1,
                      "maxItems": 16,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 2048,
                        "pattern": "^[\\x20-\\x7e]*$"
                      }
                    },
                    "pattern": {
                      "type": "string",
                      "enum": [
                        "^[a-z]+$",
                        "^[A-Za-z0-9_-]+$",
                        "^[a-z][a-z0-9-]*$"
                      ]
                    }
                  },
                  "required": ["type"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "const": "boolean" }
                  },
                  "required": ["type"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "values": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            },
            "additionalProperties": { "$ref": "#/$defs/__schema0" }
          },
          "dependencies": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,62}$"
                },
                "alias": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,62}$"
                }
              },
              "required": ["target", "alias"],
              "additionalProperties": false
            }
          },
          "templates": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^templates\\/[A-Za-z0-9][A-Za-z0-9_.-]*\\.yaml$"
            },
            "additionalProperties": {
              "minItems": 1,
              "maxItems": 128,
              "type": "array",
              "items": { "type": "string", "maxLength": 2048 }
            }
          }
        },
        "required": [
          "id",
          "directory",
          "name",
          "properties",
          "values",
          "dependencies",
          "templates"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "profile",
    "helmVersion",
    "kubernetesVersion",
    "platform",
    "release",
    "namespace",
    "charts"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^[\\x20-\\x7e]*$"
            },
            { "type": "number", "minimum": -1000000, "maximum": 1000000 },
            { "type": "boolean" }
          ]
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": { "$ref": "#/$defs/__schema0" }
        }
      ]
    }
  }
}
