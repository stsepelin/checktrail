{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "number", "const": 1 },
        "rubyVersion": { "type": "string", "const": "4.0.7" },
        "bundlerVersion": { "type": "string", "const": "4.0.20" },
        "repository": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "repositoryManifest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "repositorySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sources": {
          "minItems": 1,
          "maxItems": 2048,
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "cops": {
          "minItems": 1,
          "maxItems": 512,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:Lint|Layout|Style|Naming|Metrics|Security)\\/[A-Za-z][A-Za-z0-9]+$"
          }
        },
        "rspec": {
          "type": "object",
          "properties": {
            "files": {
              "maxItems": 256,
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
            },
            "support": {
              "maxItems": 256,
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          },
          "required": ["files", "support"],
          "additionalProperties": false
        },
        "minitest": {
          "type": "object",
          "properties": {
            "files": {
              "maxItems": 256,
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
            },
            "support": {
              "maxItems": 256,
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          },
          "required": ["files", "support"],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "rubyVersion",
        "bundlerVersion",
        "repository",
        "repositoryManifest",
        "repositorySha256",
        "sources",
        "cops",
        "rspec",
        "minitest"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "number", "const": 2 },
        "rubyVersion": { "type": "string", "const": "4.0.7" },
        "bundlerVersion": { "type": "string", "const": "4.0.20" },
        "repository": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "repositoryManifest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "repositorySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sources": {
          "minItems": 1,
          "maxItems": 2048,
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "cops": {
          "minItems": 1,
          "maxItems": 512,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:Lint|Layout|Style|Naming|Metrics|Security)\\/[A-Za-z][A-Za-z0-9]+$"
          }
        },
        "rspec": {
          "type": "object",
          "properties": {
            "files": {
              "maxItems": 256,
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
            },
            "support": {
              "maxItems": 256,
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          },
          "required": ["files", "support"],
          "additionalProperties": false
        },
        "minitest": {
          "type": "object",
          "properties": {
            "files": {
              "maxItems": 256,
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
            },
            "support": {
              "maxItems": 256,
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          },
          "required": ["files", "support"],
          "additionalProperties": false
        },
        "extensions": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string",
              "const": "declared-manifests-shared-and-inherited-v1"
            },
            "manifests": {
              "minItems": 1,
              "maxItems": 64,
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
            },
            "rspecHooks": {
              "maxItems": 512,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["before", "after", "around"]
                  },
                  "scope": { "type": "string", "enum": ["example", "context"] },
                  "file": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "line": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000
                  },
                  "registrations": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 20000
                  },
                  "invocations": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 100000
                  }
                },
                "required": [
                  "kind",
                  "scope",
                  "file",
                  "line",
                  "registrations",
                  "invocations"
                ],
                "additionalProperties": false
              }
            },
            "dependencies": {
              "minItems": 1,
              "maxItems": 512,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_]+(?:-[A-Za-z0-9_]+)*$"
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
                  },
                  "groups": {
                    "minItems": 1,
                    "maxItems": 32,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 128,
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                    }
                  },
                  "platforms": {
                    "maxItems": 16,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["ruby", "mri", "jruby", "windows", "truffleruby"]
                    }
                  },
                  "included": { "type": "boolean" },
                  "platformMatches": { "type": "boolean" }
                },
                "required": [
                  "name",
                  "version",
                  "groups",
                  "platforms",
                  "included",
                  "platformMatches"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": ["profile", "manifests", "rspecHooks", "dependencies"],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "rubyVersion",
        "bundlerVersion",
        "repository",
        "repositoryManifest",
        "repositorySha256",
        "sources",
        "cops",
        "rspec",
        "minitest",
        "extensions"
      ],
      "additionalProperties": false
    }
  ]
}
