{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "archive": {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "number", "const": 1 },
        "format": { "type": "string", "const": "checktrail-report-json-v1" },
        "taskId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reportSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
        "chunkBytes": { "type": "number", "const": 65536 },
        "chunks": { "type": "integer", "minimum": 1, "maximum": 512 }
      },
      "required": [
        "schemaVersion",
        "format",
        "taskId",
        "sourceFingerprint",
        "reportSha256",
        "bytes",
        "chunkBytes",
        "chunks"
      ],
      "additionalProperties": false
    },
    "index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "bodyBase64": { "type": "string", "minLength": 4, "maxLength": 87384 }
  },
  "required": ["archive", "index", "bytes", "sha256", "bodyBase64"],
  "additionalProperties": false
}
