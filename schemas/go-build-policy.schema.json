{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "profiles": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "tags": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "checks": {
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "go.vet",
                "go.test",
                "go.test-race",
                "go.staticcheck",
                "go.golangci-lint"
              ]
            }
          },
          "excludedFiles": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 4096,
                  "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*[\\\\*?[\\]{}])[\\u0020-\\u007e\\u0080-\\uffff]+\\.go$"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000,
                  "pattern": "\\S"
                }
              },
              "required": ["path", "reason"],
              "additionalProperties": false
            }
          }
        },
        "required": ["name", "tags", "checks", "excludedFiles"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "profiles"],
  "additionalProperties": false
}
