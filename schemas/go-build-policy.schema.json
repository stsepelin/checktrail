{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "number", "const": 1 },
        "profiles": {
          "minItems": 1,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "tags": {
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              },
              "excludedFiles": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "maxLength": 4096,
                      "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*[\\\\*?[\\]{}])[\\u0020-\\u007e\\u0080-\\uffff]+\\.go$"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000,
                      "pattern": "\\S"
                    }
                  },
                  "required": ["path", "reason"],
                  "additionalProperties": false
                }
              },
              "checks": {
                "minItems": 1,
                "maxItems": 5,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "go.vet",
                    "go.test",
                    "go.test-race",
                    "go.staticcheck",
                    "go.golangci-lint"
                  ]
                }
              }
            },
            "required": ["name", "tags", "excludedFiles", "checks"],
            "additionalProperties": false
          }
        }
      },
      "required": ["schemaVersion", "profiles"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "number", "const": 2 },
        "profiles": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "tags": {
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              },
              "excludedFiles": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "maxLength": 4096,
                      "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*[\\\\*?[\\]{}])[\\u0020-\\u007e\\u0080-\\uffff]+\\.go$"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000,
                      "pattern": "\\S"
                    }
                  },
                  "required": ["path", "reason"],
                  "additionalProperties": false
                }
              },
              "checks": {
                "minItems": 1,
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "go.vet",
                    "go.test",
                    "go.test-race",
                    "go.staticcheck",
                    "go.golangci-lint",
                    "go.build"
                  ]
                }
              },
              "repetitions": { "type": "integer", "minimum": 1, "maximum": 16 },
              "target": {
                "type": "object",
                "properties": {
                  "os": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]{0,15}$"
                  },
                  "arch": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]{0,15}$"
                  },
                  "cgo": { "type": "boolean" }
                },
                "required": ["os", "arch", "cgo"],
                "additionalProperties": false
              }
            },
            "required": [
              "name",
              "tags",
              "excludedFiles",
              "checks",
              "repetitions"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["schemaVersion", "profiles"],
      "additionalProperties": false
    }
  ]
}
