{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "const": "declared-claim-support-probability-v1"
    },
    "event": { "type": "string", "const": "supported-in-scope-actionable" },
    "probability": {
      "anyOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "null" }
      ]
    },
    "calibratedConfidence": { "type": "boolean", "const": false }
  },
  "required": ["profile", "event", "probability", "calibratedConfidence"],
  "additionalProperties": false
}
