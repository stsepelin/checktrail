{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "const": "sealed-multi-claim-paired-synthetic-v1"
    },
    "seed": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "resamples": { "type": "integer", "minimum": 128, "maximum": 4096 },
    "confidenceLevel": { "type": "number", "minimum": 0.8, "maximum": 0.99 },
    "matching": {
      "type": "object",
      "properties": {
        "instructions": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "host": {
          "type": "object",
          "properties": {
            "client": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            },
            "clientVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            },
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
            }
          },
          "required": ["client", "clientVersion", "provider", "model"],
          "additionalProperties": false
        }
      },
      "required": ["instructions", "host"],
      "additionalProperties": false
    },
    "cases": {
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "defects": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                },
                "family": {
                  "type": "string",
                  "enum": [
                    "authorization-tenancy",
                    "identifiers-allowlists",
                    "types-numeric-semantics",
                    "lifecycle-ordering",
                    "assembly-wiring",
                    "concurrency-resources",
                    "atomic-artifacts",
                    "dependencies-builds",
                    "test-adequacy"
                  ]
                },
                "material": { "type": "boolean" }
              },
              "required": ["id", "family", "material"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "defects"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "profile",
    "seed",
    "resamples",
    "confidenceLevel",
    "matching",
    "cases"
  ],
  "additionalProperties": false
}
