{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "assembly": { "type": "string", "minLength": 1, "maxLength": 256 },
    "environment": { "type": "string", "const": "test" },
    "probes": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^\\/(?!\\/)[^\\r\\n#]*$"
          },
          "matched": {
            "minItems": 1,
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 4096,
                  "pattern": "^\\/"
                },
                "name": {
                  "anyOf": [
                    { "type": "string", "maxLength": 256 },
                    { "type": "null" }
                  ]
                }
              },
              "required": ["path", "name"],
              "additionalProperties": false
            }
          }
        },
        "required": ["path", "matched"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "assembly", "environment", "probes"],
  "additionalProperties": false
}
