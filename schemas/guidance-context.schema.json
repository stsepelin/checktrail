{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "checks": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z0-9][a-z0-9.-]*$"
      }
    },
    "topics": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "test-lifecycle",
          "analysis-scope",
          "package-consumers",
          "python-imports",
          "framework-assembly",
          "execution-depth"
        ]
      }
    }
  },
  "required": ["schemaVersion", "checks", "topics"],
  "additionalProperties": false
}
