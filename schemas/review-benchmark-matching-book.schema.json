{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "protocolDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "collectionDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "judgingDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "judgmentsDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "slots": {
      "minItems": 2,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "matchingId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "assignmentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["matchingId", "assignmentDigest"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "protocolDigest",
    "collectionDigest",
    "judgingDigest",
    "judgmentsDigest",
    "slots"
  ],
  "additionalProperties": false
}
