{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "distribution": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "repository": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "repositoryManifest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "repositorySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "modules": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "anyOf": [
              { "type": "string", "const": "." },
              { "type": "string", "minLength": 1, "maxLength": 4096 }
            ]
          },
          "kind": { "type": "string", "enum": ["aggregator", "java"] },
          "testClasses": {
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": { "type": "string", "minLength": 1, "maxLength": 4096 },
                "className": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][\\w$]*(?:\\.[A-Za-z_$][\\w$]*)*$"
                }
              },
              "required": ["file", "className"],
              "additionalProperties": false
            }
          },
          "supportTests": {
            "maxItems": 256,
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        },
        "required": ["path", "kind", "testClasses", "supportTests"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "distribution",
    "repository",
    "repositoryManifest",
    "repositorySha256",
    "modules"
  ],
  "additionalProperties": false
}
