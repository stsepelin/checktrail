{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "nativeExtensions": {
      "minItems": 1,
      "maxItems": 128,
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "classes": {
      "minItems": 2,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "class": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^[A-Za-z_]\\w*(?:\\\\[A-Za-z_]\\w*)*$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?![A-Za-z]:)(?!\\/)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*\\/$)[^\\\\\\0\\r\\n]+$"
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "generated": { "type": "boolean" }
        },
        "required": ["class", "path", "sha256", "generated"],
        "additionalProperties": false
      }
    },
    "models": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "class": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^[A-Za-z_]\\w*(?:\\\\[A-Za-z_]\\w*)*$"
          },
          "expectedClass": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^[A-Za-z_]\\w*(?:\\\\[A-Za-z_]\\w*)*$"
          },
          "defaults": {
            "type": "object",
            "properties": {
              "table": { "type": "string" },
              "connection": { "type": ["string", "null"] },
              "keyName": { "type": "string" },
              "keyType": { "type": "string" },
              "incrementing": { "type": "boolean" },
              "timestamps": { "type": "boolean" },
              "perPage": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "eagerLoads": {
                "maxItems": 1024,
                "type": "array",
                "items": { "type": "string" }
              },
              "eagerCounts": {
                "maxItems": 1024,
                "type": "array",
                "items": { "type": "string" }
              },
              "casts": {
                "type": "object",
                "propertyNames": { "type": "string" },
                "additionalProperties": { "type": "string" }
              },
              "attributes": {
                "type": "object",
                "propertyNames": { "type": "string" },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "null",
                        "string",
                        "int",
                        "float",
                        "bool",
                        "array"
                      ]
                    },
                    "value": { "$ref": "#/$defs/__schema0" }
                  },
                  "required": ["type", "value"],
                  "additionalProperties": false
                }
              },
              "appends": {
                "maxItems": 1024,
                "type": "array",
                "items": { "type": "string" }
              },
              "fillable": {
                "maxItems": 1024,
                "type": "array",
                "items": { "type": "string" }
              },
              "guarded": {
                "maxItems": 1024,
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "required": [
              "table",
              "connection",
              "keyName",
              "keyType",
              "incrementing",
              "timestamps",
              "perPage",
              "eagerLoads",
              "eagerCounts",
              "casts",
              "attributes",
              "appends",
              "fillable",
              "guarded"
            ],
            "additionalProperties": false
          },
          "probes": {
            "minItems": 1,
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "attribute": {
                  "type": "string",
                  "maxLength": 256,
                  "pattern": "^[A-Za-z_]\\w*$"
                },
                "attributes": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "maxLength": 256,
                    "pattern": "^[A-Za-z_]\\w*$"
                  },
                  "additionalProperties": { "$ref": "#/$defs/__schema1" }
                },
                "expected": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "null",
                        "string",
                        "int",
                        "float",
                        "bool",
                        "array"
                      ]
                    },
                    "value": { "$ref": "#/$defs/__schema0" }
                  },
                  "required": ["type", "value"],
                  "additionalProperties": false
                }
              },
              "required": ["attribute", "attributes", "expected"],
              "additionalProperties": false
            }
          }
        },
        "required": ["class", "expectedClass", "defaults", "probes"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "nativeExtensions", "classes", "models"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema0" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema0" }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema1" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema1" }
        }
      ]
    }
  }
}
