            }
          },
          "required": [
            "selected",
            "observed",
            "unresolved",
            "notRun",
            "triggerMismatches",
            "controlMismatches"
          ],
          "additionalProperties": false
        },
        "schemaVersion": { "type": "number", "const": 2 },
        "nativeBudget": {
          "type": "object",
          "properties": {
            "scope": { "type": "string", "const": "native-probe-run" },
            "limits": {
              "type": "object",
              "properties": {
                "maxCalls": { "type": "integer", "minimum": 0, "maximum": 16 },
                "maxOutputBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777216
                },
                "wallMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 120000
                },
                "maxCallOutputBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1048576
                }
              },
              "required": [
                "maxCalls",
                "maxOutputBytes",
                "wallMs",
                "maxCallOutputBytes"
              ],
              "additionalProperties": false
            },
            "calls": { "type": "integer", "minimum": 0, "maximum": 16 },
            "outputBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "stopReason": {
              "type": "string",
              "enum": ["none", "call-limit", "output-limit"]
            },
            "outputByteCeilingGuaranteed": { "type": "boolean", "const": false }
          },
          "required": [
