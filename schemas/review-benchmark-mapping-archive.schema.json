{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "protocolDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "collectionDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "judgingDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "judgmentsDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "matchingDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "mappings": {
      "minItems": 2,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "matchingId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "status": {
            "type": "string",
            "enum": [
              "missing",
              "unavailable",
              "invalid",
              "foreign",
              "incomplete",
              "accepted"
            ]
          },
          "responseDigest": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          },
          "responseBase64": {
            "anyOf": [
              { "type": "string", "maxLength": 349528 },
              { "type": "null" }
            ]
          }
        },
        "required": [
          "matchingId",
          "status",
          "responseDigest",
          "responseBase64"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "protocolDigest",
    "collectionDigest",
    "judgingDigest",
    "judgmentsDigest",
    "matchingDigest",
    "createdAt",
    "mappings"
  ],
  "additionalProperties": false
}
