{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "file": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "binding": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "trialId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "protocolDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": ["runId", "trialId", "protocolDigest"],
      "additionalProperties": false
    },
    "maxBytes": {
      "default": 67108864,
      "type": "integer",
      "minimum": 0,
      "maximum": 134217728
    },
    "maxEvents": {
      "default": 1024,
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    }
  },
  "required": ["file", "maxBytes", "maxEvents"],
  "additionalProperties": false
}
