{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "engineVersion": { "type": "string" },
    "provenance": { "type": "string", "const": "finding-comparison" },
    "outcome": { "type": "string", "enum": ["passed", "failed", "incomplete"] },
    "validationOutcome": {
      "type": "string",
      "enum": ["passed", "failed", "incomplete"]
    },
    "reason": { "type": "string" },
    "sourceVerified": { "type": "boolean" },
    "baselineFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "counts": {
      "type": "object",
      "properties": {
        "current": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "new": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "matched": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expired": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "changed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unverified": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expanded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "modified": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "current",
        "new",
        "matched",
        "stale",
        "expired",
        "changed",
        "unverified",
        "expanded",
        "modified"
      ],
      "additionalProperties": false
    },
    "limitExceeded": { "type": "boolean" },
    "unaccountedFailures": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "engineVersion",
    "provenance",
    "outcome",
    "validationOutcome",
    "reason",
    "sourceVerified",
    "baselineFingerprint",
    "counts",
    "limitExceeded",
    "unaccountedFailures"
  ],
  "additionalProperties": false
}
