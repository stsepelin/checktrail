              "maxLength": 4096,
              "pattern": "^(?![A-Za-z]:)(?!\\/)(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))[^\\\\\\0\\r\\n]+$"
            },
            "consumers": {
              "minItems": 1,
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?![A-Za-z]:)(?!\\/)(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))[^\\\\\\0\\r\\n]+$"
              }
            }
          },
          "required": ["sourceDirectory", "entry", "consumers"],
          "additionalProperties": false
        }
      },
      "required": ["schemaVersion", "eslint"],
      "additionalProperties": false
    },
