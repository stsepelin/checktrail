            "sourceParticipation": { "type": "boolean", "const": true }
          },
          "required": ["sourceParticipation"],
          "additionalProperties": false
        },
        "nodeTest": {
          "type": "object",
          "properties": {
            "loaders": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "enum": ["import", "require"] },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "^(?![A-Za-z]:)(?!\\/)(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))[^\\\\\\0\\r\\n]+$"
                  },
                  "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                },
                "required": ["kind", "path", "sha256"],
                "additionalProperties": false
              }
            }
          },
          "required": ["loaders"],
          "additionalProperties": false
        },
        "library": {
          "type": "object",
          "properties": {
