{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "engineVersion": { "type": "string" },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "outcome": { "type": "string", "enum": ["passed", "failed", "incomplete"] },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sourceChanged": { "type": "boolean" },
    "sourceError": { "type": "boolean" },
    "selection": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["full", "affected"] },
        "reason": { "type": "string" },
        "changedFiles": { "type": "array", "items": { "type": "string" } },
        "selectedProjects": { "type": "array", "items": { "type": "string" } },
        "git": {
          "type": "object",
          "properties": {
            "baseCommit": { "type": "string" },
            "headCommit": { "type": "string" },
            "version": { "type": "string" },
            "worktreeId": { "type": "string" },
            "indexFingerprint": { "type": "string" }
          },
          "required": [
            "baseCommit",
            "headCommit",
            "version",
            "worktreeId",
            "indexFingerprint"
          ],
          "additionalProperties": false
        }
      },
      "required": ["mode", "reason", "changedFiles", "selectedProjects"],
      "additionalProperties": false
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "sourceFingerprint": { "type": "string" },
    "finalSourceFingerprint": { "type": ["string", "null"] },
    "policyFingerprint": { "type": "string" },
    "excluded": { "type": "array", "items": { "type": "string" } },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "external": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^external\\.[a-z][a-z0-9-]{0,63}$"
              },
              "version": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
              },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "tools": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "version": { "type": "string" },
                    "source": { "type": "string", "const": "adapter-reported" }
                  },
                  "required": ["name", "version", "source"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["id", "version", "sha256"],
            "additionalProperties": false
          },
          "id": { "type": "string" },
          "adapter": { "type": "string" },
          "project": { "type": "string" },
          "scope": { "type": "array", "items": { "type": "string" } },
          "goScope": {
            "type": "object",
            "properties": {
              "schemaVersion": { "type": "number", "const": 1 },
              "excludedFiles": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "maxLength": 4096,
                      "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*[\\\\*?[\\]{}])[\\u0020-\\u007e\\u0080-\\uffff]+\\.go$"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000,
                      "pattern": "\\S"
                    }
                  },
                  "required": ["path", "reason"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["schemaVersion", "excludedFiles"],
            "additionalProperties": false
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "unavailable",
              "skipped",
              "error",
              "inconclusive"
            ]
          },
          "reason": { "type": "string" },
          "processes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "object",
                  "properties": {
                    "temporaryDirectory": { "type": "boolean" },
                    "executable": { "type": "string" },
                    "args": { "type": "array", "items": { "type": "string" } },
                    "cwd": { "type": "string" },
                    "env": {
                      "type": "object",
                      "propertyNames": { "type": "string" },
                      "additionalProperties": { "type": "string" }
                    }
                  },
                  "required": ["executable", "args", "cwd"],
                  "additionalProperties": false
                },
                "exitCode": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    { "type": "null" }
                  ]
                },
                "signal": { "type": ["string", "null"] },
                "stdout": { "type": "string" },
                "stderr": { "type": "string" },
                "durationMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "timedOut": { "type": "boolean" },
                "cancelled": { "type": "boolean" },
                "truncated": { "type": "boolean" },
                "errorCode": { "type": "string" }
              },
              "required": [
                "command",
                "exitCode",
                "signal",
                "stdout",
                "stderr",
                "durationMs",
                "timedOut",
                "cancelled",
                "truncated"
              ],
              "additionalProperties": false
            }
          },
          "tests": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "passed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "failed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "skipped": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["total", "passed", "failed", "skipped"],
            "additionalProperties": false
          },
          "findingsComplete": { "type": "boolean" },
          "runtime": {
            "type": "object",
            "properties": {
              "schemaVersion": { "type": "number", "const": 1 },
              "format": { "type": "string", "const": "runtime-inventory" },
              "producer": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": ["name", "version"],
                "additionalProperties": false
              },
              "assembly": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "environment": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": ["name", "environment"],
                "additionalProperties": false
              },
              "sourceFingerprint": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "capturedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "collections": {
                "minItems": 1,
                "maxItems": 5,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "routes",
                        "listeners",
                        "middleware",
                        "schedules",
                        "bindings"
                      ]
                    },
                    "complete": { "type": "boolean" },
                    "ordered": { "type": "boolean" },
                    "entries": {
                      "maxItems": 20000,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          },
                          "attributes": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 4096
                            },
                            "additionalProperties": {
                              "anyOf": [
                                { "type": "string", "maxLength": 4096 },
                                { "type": "number" },
                                { "type": "boolean" },
                                { "type": "null" },
                                {
                                  "maxItems": 1024,
                                  "type": "array",
                                  "items": {
                                    "type": "string",
                                    "maxLength": 4096
                                  }
                                }
                              ]
                            }
                          }
                        },
                        "required": ["key", "attributes"],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": ["kind", "complete", "ordered", "entries"],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "schemaVersion",
              "format",
              "producer",
              "assembly",
              "sourceFingerprint",
              "capturedAt",
              "collections"
            ],
            "additionalProperties": false
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ruleId": { "type": "string", "minLength": 1 },
                "level": {
                  "type": "string",
                  "enum": ["error", "warning", "note"]
                },
                "message": { "type": "string" },
                "file": { "type": "string", "minLength": 1 },
                "line": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["ruleId", "level", "message"],
              "additionalProperties": false
            }
          },
          "environment": {
            "type": "object",
            "properties": {
              "names": { "type": "array", "items": { "type": "string" } },
              "fingerprint": { "type": "string" }
            },
            "required": ["names", "fingerprint"],
            "additionalProperties": false
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "source": {
                  "type": "string",
                  "enum": [
                    "engine-runtime",
                    "package-metadata",
                    "version-command"
                  ]
                },
                "version": { "type": ["string", "null"] },
                "status": {
                  "type": "string",
                  "enum": ["identified", "unavailable", "inconclusive"]
                },
                "process": {
                  "type": "object",
                  "properties": {
                    "command": {
                      "type": "object",
                      "properties": {
                        "temporaryDirectory": { "type": "boolean" },
                        "executable": { "type": "string" },
                        "args": {
                          "type": "array",
                          "items": { "type": "string" }
                        },
                        "cwd": { "type": "string" },
                        "env": {
                          "type": "object",
                          "propertyNames": { "type": "string" },
                          "additionalProperties": { "type": "string" }
                        }
                      },
                      "required": ["executable", "args", "cwd"],
                      "additionalProperties": false
                    },
                    "exitCode": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        { "type": "null" }
                      ]
                    },
                    "signal": { "type": ["string", "null"] },
                    "stdout": { "type": "string" },
                    "stderr": { "type": "string" },
                    "durationMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "timedOut": { "type": "boolean" },
                    "cancelled": { "type": "boolean" },
                    "truncated": { "type": "boolean" },
                    "errorCode": { "type": "string" }
                  },
                  "required": [
                    "command",
                    "exitCode",
                    "signal",
                    "stdout",
                    "stderr",
                    "durationMs",
                    "timedOut",
                    "cancelled",
                    "truncated"
                  ],
                  "additionalProperties": false
                },
                "path": { "type": "string" }
              },
              "required": ["name", "source", "version", "status"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "adapter",
          "project",
          "scope",
          "status",
          "reason",
          "processes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "engineVersion",
    "runId",
    "outcome",
    "durationMs",
    "sourceChanged",
    "sourceError",
    "startedAt",
    "sourceFingerprint",
    "finalSourceFingerprint",
    "policyFingerprint",
    "excluded",
    "checks"
  ],
  "additionalProperties": false
}
