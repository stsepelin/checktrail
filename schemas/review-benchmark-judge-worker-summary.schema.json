{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "profile": {
      "type": "string",
      "const": "workflow-journal-paired-synthetic-v1"
    },
    "claimsVerified": { "type": "boolean", "const": false },
    "hostIsolationVerified": { "type": "boolean", "const": false },
    "externalAttemptsComplete": { "type": "boolean", "const": false },
    "qualityAssessed": { "type": "boolean", "const": false },
    "format": {
      "type": "string",
      "const": "review-benchmark-judge-worker-summary"
    },
    "state": {
      "type": "string",
      "enum": ["frozen", "collected", "judging-prepared", "judgments-sealed"]
    },
    "blindId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "status": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "missing",
            "unavailable",
            "invalid",
            "foreign",
            "incomplete",
            "accepted"
          ]
        },
        { "type": "null" }
      ]
    },
    "responseDigest": {
      "anyOf": [
        { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        { "type": "null" }
      ]
    },
    "sourceIncluded": { "type": "boolean", "const": false }
  },
  "required": [
    "schemaVersion",
    "profile",
    "claimsVerified",
    "hostIsolationVerified",
    "externalAttemptsComplete",
    "qualityAssessed",
    "format",
    "state",
    "blindId",
    "status",
    "responseDigest",
    "sourceIncluded"
  ],
  "additionalProperties": false
}
