{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "files": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "topics": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "test-lifecycle",
          "analysis-scope",
          "package-consumers",
          "python-imports",
          "framework-assembly",
          "execution-depth"
        ]
      }
    }
  },
  "required": ["schemaVersion", "files", "topics"],
  "additionalProperties": false
}
