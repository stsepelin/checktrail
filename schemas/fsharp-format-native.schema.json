{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "processId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "runtime": { "type": "string", "const": "10.0.12" },
    "fantomas": { "type": "string", "const": "8.0.7.0" },
    "helperSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "loaded": {
      "minItems": 4,
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 256 },
          "version": { "type": "string", "minLength": 1, "maxLength": 128 },
          "file": { "type": "string", "minLength": 1, "maxLength": 8192 }
        },
        "required": ["name", "version", "file"],
        "additionalProperties": false
      }
    },
    "documents": {
      "minItems": 1,
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string", "minLength": 1, "maxLength": 8192 },
          "signature": { "type": "boolean" },
          "sourceBytes": { "type": "integer", "minimum": 0, "maximum": 65536 },
          "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "utf8Bom": { "type": "boolean" },
          "text": { "type": "string", "maxLength": 65536 },
          "textSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "validationInvoked": { "type": "boolean", "const": true },
          "isValid": { "type": "boolean" },
          "validationDiagnosticScope": {
            "type": "string",
            "const": "intolerant-first-failing-combination"
          },
          "diagnostics": {
            "maxItems": 1024,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "type": "string",
                  "enum": ["Error", "Warning", "Info"]
                },
                "subcategory": { "type": "string", "maxLength": 1024 },
                "code": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    { "type": "null" }
                  ]
                },
                "message": { "type": "string", "maxLength": 65536 },
                "range": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "file": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 8192
                        },
                        "startLine": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "startColumn": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "endLine": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "endColumn": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "file",
                        "startLine",
                        "startColumn",
                        "endLine",
                        "endColumn"
                      ],
                      "additionalProperties": false
                    },
                    { "type": "null" }
                  ]
                }
              },
              "required": [
                "severity",
                "subcategory",
                "code",
                "message",
                "range"
              ],
              "additionalProperties": false
            }
          },
          "formattingInvoked": { "type": "boolean", "const": true },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["parse", "define-parse", "format"]
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 131072
                  },
                  "combinations": {
                    "maxItems": 1024,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    }
                  },
                  "diagnostics": {
                    "maxItems": 1024,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "severity": {
                          "type": "string",
                          "enum": ["Error", "Warning", "Info"]
                        },
                        "subcategory": { "type": "string", "maxLength": 1024 },
                        "code": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            { "type": "null" }
                          ]
                        },
                        "message": { "type": "string", "maxLength": 65536 },
                        "range": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "file": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 8192
                                },
                                "startLine": {
                                  "type": "integer",
                                  "exclusiveMinimum": 0,
                                  "maximum": 9007199254740991
                                },
                                "startColumn": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 9007199254740991
                                },
                                "endLine": {
                                  "type": "integer",
                                  "exclusiveMinimum": 0,
                                  "maximum": 9007199254740991
                                },
                                "endColumn": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 9007199254740991
                                }
                              },
                              "required": [
                                "file",
                                "startLine",
                                "startColumn",
                                "endLine",
                                "endColumn"
                              ],
                              "additionalProperties": false
                            },
                            { "type": "null" }
                          ]
                        }
                      },
                      "required": [
                        "severity",
                        "subcategory",
                        "code",
                        "message",
                        "range"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "kind",
                  "type",
                  "message",
                  "combinations",
                  "diagnostics"
                ],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "after": {
            "anyOf": [
              { "type": "string", "maxLength": 131072 },
              { "type": "null" }
            ]
          },
          "afterSha256": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              { "type": "null" }
            ]
          },
          "changed": { "type": "boolean" }
        },
        "required": [
          "file",
          "signature",
          "sourceBytes",
          "sourceSha256",
          "utf8Bom",
          "text",
          "textSha256",
          "validationInvoked",
          "isValid",
          "validationDiagnosticScope",
          "diagnostics",
          "formattingInvoked",
          "error",
          "after",
          "afterSha256",
          "changed"
        ],
        "additionalProperties": false
      }
    },
    "complete": { "type": "boolean", "const": true }
  },
  "required": [
    "processId",
    "runtime",
    "fantomas",
    "helperSha256",
    "loaded",
    "documents",
    "complete"
  ],
  "additionalProperties": false
}
