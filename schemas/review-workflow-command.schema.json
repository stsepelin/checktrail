{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "operation": { "type": "string", "const": "open" },
        "context": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "required": ["operation", "context"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "operation": { "type": "string", "const": "next" },
        "workflowId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "target": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": ["operation", "workflowId"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "operation": { "type": "string", "const": "submit" },
        "workflowId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "response": {}
      },
      "required": ["operation", "workflowId", "response"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "operation": { "type": "string", "const": "probe" },
        "workflowId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "probeId": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "required": ["operation", "workflowId", "probeId"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "operation": { "type": "string", "const": "status" },
        "workflowId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": ["operation", "workflowId"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "operation": { "type": "string", "const": "close" },
        "workflowId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": ["operation", "workflowId"],
      "additionalProperties": false
    }
  ]
}
