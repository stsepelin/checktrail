{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "profile": { "type": "string", "const": "declared-multi-claim-paired-v1" },
    "purpose": { "type": "string", "enum": ["development", "held-out"] },
    "seed": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "resamples": { "type": "integer", "minimum": 128, "maximum": 4096 },
    "confidenceLevel": { "type": "number", "minimum": 0.8, "maximum": 0.99 },
    "trials": {
      "minItems": 1,
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "clusterId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          }
        },
        "required": ["id", "clusterId"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "profile",
    "purpose",
    "seed",
    "resamples",
    "confidenceLevel",
    "trials"
  ],
  "additionalProperties": false
}
