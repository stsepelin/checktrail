  "type": "object",
  "properties": {
    "directory": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "required": ["directory", "sha256"],
  "additionalProperties": false
}
