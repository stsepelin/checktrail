{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": { "type": "number", "const": 1 },
    "identity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^external\\.[a-z][a-z0-9-]{0,63}$"
        },
        "version": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": ["id", "version", "sha256"],
      "additionalProperties": false
    },
    "checkId": { "type": "string" },
    "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "files": {
      "maxItems": 20000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "status": {
            "type": "string",
            "enum": ["checked", "skipped", "unavailable"]
          },
          "tests": {
            "type": "object",
            "properties": {
              "total": { "type": "integer", "minimum": 0, "maximum": 10000000 },
              "passed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              },
              "failed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              },
              "skipped": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              }
            },
            "required": ["total", "passed", "failed", "skipped"],
            "additionalProperties": false
          }
        },
        "required": ["path", "status"],
        "additionalProperties": false
      }
    },
    "findingsComplete": { "type": "boolean" },
    "findings": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruleId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "level": { "type": "string", "enum": ["error", "warning", "note"] },
          "message": { "type": "string", "minLength": 1, "maxLength": 8192 },
          "file": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["ruleId", "level", "message"],
        "additionalProperties": false
      }
    },
    "tools": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$" },
          "version": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "required": ["name", "version"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "protocolVersion",
    "identity",
    "checkId",
    "sourceFingerprint",
    "files",
    "findingsComplete",
    "findings",
    "tools"
  ],
  "additionalProperties": false
}
