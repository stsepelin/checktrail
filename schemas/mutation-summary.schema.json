{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "engineVersion": { "type": "string" },
    "profile": { "type": "string", "const": "node-flat-tests" },
    "channel": { "type": "string", "const": "advisory" },
    "provenance": {
      "type": "string",
      "const": "temporary-copy-mutation-experiment"
    },
    "recipeDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "finalSourceFingerprint": {
      "anyOf": [
        { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        { "type": "null" }
      ]
    },
    "complete": { "type": "boolean" },
    "reason": { "type": "string" },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "runtime": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "const": "node" },
        "version": { "type": "string" }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "killed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "survived": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "invalid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inconclusive": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "notRun": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "total",
        "killed",
        "survived",
        "invalid",
        "inconclusive",
        "notRun"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "engineVersion",
    "profile",
    "channel",
    "provenance",
    "recipeDigest",
    "sourceFingerprint",
    "finalSourceFingerprint",
    "complete",
    "reason",
    "durationMs",
    "runtime",
    "counts"
  ],
  "additionalProperties": false
}
