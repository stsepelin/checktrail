{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workflowId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "targetHandle": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "probeId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "candidate": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "family": {
          "type": "string",
          "enum": [
            "authorization-tenancy",
            "identifiers-allowlists",
            "types-numeric-semantics",
            "lifecycle-ordering",
            "assembly-wiring",
            "concurrency-resources",
            "atomic-artifacts",
            "dependencies-builds",
            "test-adequacy"
          ]
        },
        "severity": { "type": "string", "enum": ["suggestion", "concern"] },
        "claim": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "trigger": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "consequence": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "evidenceGaps": {
          "maxItems": 16,
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "attribution": {
          "type": "string",
          "enum": ["regression", "pre-existing", "unknown"]
        },
        "fixScope": {
          "type": "string",
          "enum": ["this-change", "follow-up", "unknown"]
        },
        "citations": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "revision": { "type": "string", "enum": ["base", "current"] },
              "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "startLine": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65537
              },
              "endLine": { "type": "integer", "minimum": 1, "maximum": 65537 },
              "quote": { "type": "string", "minLength": 1, "maxLength": 2048 }
            },
            "required": [
              "file",
              "revision",
              "sourceDigest",
              "startLine",
              "endLine",
              "quote"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "family",
        "severity",
        "claim",
        "trigger",
        "consequence",
        "evidenceGaps",
        "attribution",
        "fixScope",
        "citations"
      ],
      "additionalProperties": false
    },
    "recipe": {
      "type": "object",
      "properties": {
        "contents": { "type": "string", "maxLength": 65536 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": ["contents", "sha256"],
      "additionalProperties": false
    },
    "run": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "format": { "type": "string", "const": "review-probe-run" },
            "engineVersion": { "type": "string" },
            "channel": { "type": "string", "const": "advisory" },
            "claimsVerified": { "type": "boolean", "const": false },
            "deterministicOutcomeChanged": {
              "type": "boolean",
              "const": false
            },
            "nativeExecution": { "type": "boolean" },
            "executionSandboxed": { "type": "boolean", "const": false },
            "profile": { "type": "string", "const": "node-export-boolean-v1" },
            "recipeDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "workerDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "functionRange": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "end": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                }
              },
              "required": ["start", "end"],
              "additionalProperties": false
            },
            "minimumTriggerScale": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "guard": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000000
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000000
                    }
                  },
                  "required": ["start", "end"],
                  "additionalProperties": false
                },
                { "type": "null" }
              ]
            },
            "contextDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "candidateDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "runtime": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "const": "node" },
                "version": { "type": "string" }
              },
              "required": ["name", "version"],
              "additionalProperties": false
            },
            "status": {
              "type": "string",
              "enum": [
                "completed",
                "incomplete",
                "cancelled",
                "timed-out",
                "stale",
                "unsupported"
              ]
            },
            "behavior": {
              "type": "string",
              "enum": ["violated", "satisfied", "unresolved"]
            },
            "requirementProvenance": {
              "type": "string",
              "const": "operator-pinned-expectations"
            },
            "callerReachability": {
              "type": "string",
              "const": "not-established"
            },
            "mechanismVerified": { "type": "boolean", "const": false },
            "fixVerified": { "type": "boolean", "const": false },
            "freshness": { "type": "string", "enum": ["current", "stale"] },
            "temporaryArtifacts": {
              "type": "string",
              "enum": ["removed", "cleanup-failed", "not-created"]
            },
            "counts": {
              "type": "object",
              "properties": {
                "selected": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "observed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "unresolved": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "notRun": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "triggerMismatches": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "controlMismatches": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                }
              },
              "required": [
                "selected",
                "observed",
                "unresolved",
                "notRun",
                "triggerMismatches",
                "controlMismatches"
              ],
              "additionalProperties": false
            },
            "schemaVersion": { "type": "number", "const": 1 },
            "trials": {
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  },
                  "role": {
                    "type": "string",
                    "enum": ["baseline", "trigger", "near-miss"]
                  },
                  "status": {
                    "type": "string",
                    "enum": ["observed", "unresolved", "not-run"]
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "boolean-observed",
                      "scale-not-met",
                      "guard-not-covered",
                      "runtime-error",
                      "malformed-evidence",
                      "timeout",
                      "cancelled",
                      "output-limit",
                      "budget-exhausted",
                      "not-started",
                      "call-limit",
                      "output-budget",
                      "cleanup-failed"
                    ]
                  },
                  "inputScale": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  "functionExecuted": { "type": "boolean" },
                  "guardCoverage": {
                    "type": "string",
                    "enum": [
                      "not-requested",
                      "executed",
                      "not-executed",
                      "unknown"
                    ]
                  },
                  "expected": { "type": "boolean" },
                  "actual": { "type": ["boolean", "null"] },
                  "matchesExpectation": { "type": ["boolean", "null"] },
                  "durationMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  "ranges": {
                    "maxItems": 128,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "start": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000000000
                        },
                        "end": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000000000
                        },
                        "count": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000000000
                        }
                      },
                      "required": ["start", "end", "count"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "id",
                  "role",
                  "status",
                  "reason",
                  "inputScale",
                  "functionExecuted",
                  "guardCoverage",
                  "expected",
                  "actual",
                  "matchesExpectation",
                  "durationMs",
                  "ranges"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "format",
            "engineVersion",
            "channel",
            "claimsVerified",
            "deterministicOutcomeChanged",
            "nativeExecution",
            "executionSandboxed",
            "profile",
            "recipeDigest",
            "workerDigest",
            "sourceDigest",
            "functionRange",
            "minimumTriggerScale",
            "guard",
            "contextDigest",
            "candidateDigest",
            "runtime",
            "status",
            "behavior",
            "requirementProvenance",
            "callerReachability",
            "mechanismVerified",
            "fixVerified",
            "freshness",
            "temporaryArtifacts",
            "counts",
            "schemaVersion",
            "trials"
          ],
          "additionalProperties": false
        },
