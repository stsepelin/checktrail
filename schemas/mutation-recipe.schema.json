{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "number", "const": 1 },
        "profile": { "type": "string", "const": "node-flat-tests" },
        "mutations": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9][a-z0-9.-]*$"
              },
              "file": { "type": "string", "minLength": 1, "maxLength": 512 },
              "expected": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "replacement": { "type": "string", "maxLength": 4096 }
            },
            "required": ["id", "file", "expected", "replacement"],
            "additionalProperties": false
          }
        }
      },
      "required": ["schemaVersion", "profile", "mutations"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "number", "const": 1 },
        "profile": {
          "type": "string",
          "enum": [
            "vitest-flat-tests",
            "jest-flat-tests",
            "pytest-flat-tests",
            "phpunit-flat-tests"
          ]
        },
        "mutations": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9][a-z0-9.-]*$"
              },
              "file": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?![A-Za-z]:)(?!\\/)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*\\/$)[^\\\\\\0\\r\\n]+$"
              },
              "expected": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "replacement": { "type": "string", "maxLength": 4096 }
            },
            "required": ["id", "file", "expected", "replacement"],
            "additionalProperties": false
          }
        }
      },
      "required": ["schemaVersion", "profile", "mutations"],
      "additionalProperties": false
    }
  ]
}
