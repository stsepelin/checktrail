{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "engineVersion": { "type": "string" },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "outcome": { "type": "string", "enum": ["passed", "failed", "incomplete"] },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sourceChanged": { "type": "boolean" },
    "sourceError": { "type": "boolean" },
    "selection": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["full", "affected"] },
        "reason": { "type": "string" },
        "projectCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "changedFileCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["mode", "reason", "projectCount", "changedFileCount"],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "unavailable",
              "skipped",
              "error",
              "inconclusive"
            ]
          },
          "tests": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "passed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "failed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "skipped": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["total", "passed", "failed", "skipped"],
            "additionalProperties": false
          }
        },
        "required": ["id", "status"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "engineVersion",
    "runId",
    "outcome",
    "durationMs",
    "sourceChanged",
    "sourceError",
    "checks"
  ],
  "additionalProperties": false
}
