              },
              "label": {
                "type": "string",
                "enum": ["defect", "valid", "near-miss", "unresolved"]
              },
              "judgement": {
                "type": "string",
                "enum": [
                  "supported",
                  "wrong-mechanism",
                  "wrong-address",
                  "unreachable-fix",
                  "out-of-scope",
                  "refuted",
                  "unresolved",
                  "none"
                ]
              }
            },
            "required": [
              "id",
              "status",
              "decision",
              "probability",
              "label",
              "judgement"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["protocol", "observations"],
      "additionalProperties": false
    }
  },
