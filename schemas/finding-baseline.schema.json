{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "createdFrom": {
      "type": "object",
      "properties": {
        "runId": { "type": "string" },
        "sourceFingerprint": { "type": "string" },
        "policyFingerprint": { "type": "string" }
      },
      "required": ["runId", "sourceFingerprint", "policyFingerprint"],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxEntries": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "maxExceptions": { "type": "integer", "minimum": 0, "maximum": 10000 }
      },
      "required": ["maxEntries", "maxExceptions"],
      "additionalProperties": false
    },
    "entries": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "checkId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "project": {
            "anyOf": [
              { "type": "string", "const": "." },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?![A-Za-z]:)(?:(?!\\.{1,2}\\/)[^/\\\\\\0]+\\/)*(?!\\.{1,2}$)[^/\\\\\\0]+$"
              }
            ]
          },
          "ruleId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?![A-Za-z]:)(?:(?!\\.{1,2}\\/)[^/\\\\\\0]+\\/)*(?!\\.{1,2}$)[^/\\\\\\0]+$"
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "level": { "type": "string", "enum": ["error", "warning", "note"] },
          "messageHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "occurrences": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 100000
          },
          "kind": { "type": "string", "enum": ["baseline", "exception"] },
          "owner": { "type": "string", "minLength": 1, "maxLength": 256 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "checkId",
          "project",
          "ruleId",
          "file",
          "line",
          "level",
          "messageHash",
          "id",
          "occurrences",
          "kind",
          "owner",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "createdFrom", "limits", "entries"],
  "additionalProperties": false
}
