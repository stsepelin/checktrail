{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "assignmentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "host": {
      "type": "object",
      "properties": {
        "client": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "clientVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "isolation": { "type": "string", "enum": ["fresh", "unknown"] }
      },
      "required": [
        "client",
        "clientVersion",
        "provider",
        "model",
        "sessionId",
        "isolation"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["completed", "incomplete", "refused", "unavailable", "cancelled"]
    },
    "usage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "outputTokens": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "durationMs": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "costUSD": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 1000000 },
            { "type": "null" }
          ]
        }
      },
      "required": ["inputTokens", "outputTokens", "durationMs", "costUSD"],
      "additionalProperties": false
    },
    "matchingId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "output": {
      "anyOf": [
        {
          "maxItems": 192,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claimId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "match": {
                "type": "string",
                "enum": ["defect", "none", "unresolved"]
              },
              "defectId": {
                "anyOf": [
                  { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  { "type": "null" }
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "citations": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "revision": {
                      "type": "string",
                      "enum": ["base", "current"]
                    },
                    "sourceDigest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "startLine": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65537
                    },
                    "endLine": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65537
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    }
                  },
                  "required": [
                    "file",
                    "revision",
                    "sourceDigest",
                    "startLine",
                    "endLine",
                    "quote"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "claimId",
              "match",
              "defectId",
              "rationale",
              "citations"
            ],
            "additionalProperties": false
          }
        },
        { "type": "null" }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "assignmentDigest",
    "host",
    "status",
    "usage",
    "matchingId",
    "output"
  ],
  "additionalProperties": false
}
